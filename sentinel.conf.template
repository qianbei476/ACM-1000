# Redis Sentinel 配置文件模板
# 绑定到所有网络接口（使用 host 网络模式时）
bind 0.0.0.0

# Sentinel 运行端口（每个 sentinel 需要不同的端口）
# sentinel1: 26379
# sentinel2: 26380
# sentinel3: 26381
port 26379

# 工作目录
dir /tmp

# 监控的 Redis Master 配置
# sentinel monitor <master-name> <ip> <port> <quorum>
# quorum: 至少需要多少个 sentinel 同意才能进行故障转移
sentinel monitor mymaster 127.0.0.1 6379 2

# Master 被认为下线的超时时间（毫秒）
sentinel down-after-milliseconds mymaster 5000

# 故障转移超时时间（毫秒）
sentinel failover-timeout mymaster 10000

# 在故障转移期间，最多有多少个 slave 同时对新的 master 进行同步
sentinel parallel-syncs mymaster 1

# 不启用保护模式，允许远程连接
protected-mode no

# 日志级别
loglevel notice

# 不使用后台运行（Docker 容器需要前台运行）
daemonize no
